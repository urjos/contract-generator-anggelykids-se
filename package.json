{
  "name": "anggely-kids-contratos",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android",
    "db:reset": "npx supabase db reset",
    "db:test": "npx supabase test db",
    "db:types": "npx supabase gen types typescript --local --schema public > types/database.ts",
    "db:push:remote": "npx supabase db push --remote",
    "db:push:remote:dry": "npx supabase db push --dry-run --remote",
    "db:seed:remote": "npx supabase db query --remote --file supabase/seed.sql --yes",
    "db:test:remote": "node scripts/run-remote-db-tests.mjs",
    "db:types:remote": "npx supabase gen types typescript --remote --schema public > types/database.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.64.0",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tslib": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.22",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~58.0.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  }
}
